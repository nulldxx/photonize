<Window x:Class="Photonize.Views.ExtractClipDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Photonize.Views"
        Title="Extract Clip" Height="640" Width="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        BorderBrush="#FF2A2A2A"
        BorderThickness="1"
        WindowStyle="None"
        AllowsTransparency="False">

    <Grid Background="#FF1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" Background="#FF2D2D30" Padding="15,10">
            <TextBlock Text="Extract a clip"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#FFF1F1F1"/>
        </Border>

        <TextBlock Grid.Row="1"
                   x:Name="SubjectText"
                   FontSize="12"
                   Foreground="#FFB4B4B4"
                   TextWrapping="Wrap"
                   Margin="20,15,20,5"/>

        <!-- Preview -->
        <Grid Grid.Row="2" Margin="20,5,20,0">
            <MediaElement x:Name="Preview"
                          LoadedBehavior="Manual"
                          ScrubbingEnabled="True"
                          Stretch="Uniform"
                          MediaOpened="Preview_MediaOpened"
                          MediaFailed="Preview_MediaFailed"/>

            <!-- Shown instead when Windows has no codec. The filmstrip is decoded
                 by FFmpeg, so the cell under the playhead still gives a still. -->
            <Grid x:Name="NoCodecPanel" Visibility="Collapsed" Background="#FF141414">
                <Image x:Name="FallbackFrame" Stretch="Uniform" Margin="0,0,0,40"/>
                <TextBlock VerticalAlignment="Bottom"
                           HorizontalAlignment="Center"
                           Margin="15,10"
                           FontSize="11"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="#FFB4B4B4"
                           Text="Windows has no codec to play this clip, so it cannot be previewed here. The filmstrip below is decoded by FFmpeg, so trimming still works."/>
            </Grid>
        </Grid>

        <!-- Transport -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="20,10,20,0">
            <Button x:Name="PlayButton"
                    Content="▶"
                    Click="PlayButton_Click"
                    Width="35" Height="28"
                    FontSize="14"
                    Style="{StaticResource VideoControlButtonStyle}"/>
            <TextBlock x:Name="PlayHint"
                       Text="Plays the selected range"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"
                       FontSize="11"
                       Foreground="#FF808080"/>
        </StackPanel>

        <views:TrimBar x:Name="Trim" Grid.Row="4" Margin="20,12,20,0"/>

        <StackPanel Grid.Row="5" Margin="20,12,20,0">
            <TextBlock x:Name="RangeText"
                       FontSize="15"
                       TextAlignment="Center"
                       Foreground="#FFF1F1F1"/>

            <CheckBox x:Name="PreciseBox"
                      Content="Precise — re-encode so the cut lands on the exact frame"
                      Foreground="#FFF1F1F1"
                      Margin="0,12,0,0"
                      HorizontalAlignment="Center"
                      Checked="PreciseBox_Changed"
                      Unchecked="PreciseBox_Changed"/>

            <TextBlock x:Name="ModeNote"
                       FontSize="11"
                       Foreground="#FF808080"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="20,15,20,20">
            <Button Content="Cancel"
                    Click="CancelButton_Click"
                    IsCancel="True"
                    Padding="20,8"
                    MinWidth="90"
                    Margin="0,0,10,0"/>
            <Button x:Name="ExtractButton"
                    Content="Extract"
                    Click="ExtractButton_Click"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Padding="20,8"
                    MinWidth="90"/>
        </StackPanel>
    </Grid>
</Window>
