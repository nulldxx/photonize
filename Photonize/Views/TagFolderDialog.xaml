<Window x:Class="Photonize.Views.TagFolderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Move Tagged Images" Height="380" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        BorderBrush="#FF2A2A2A"
        BorderThickness="1"
        WindowStyle="None"
        AllowsTransparency="False">

    <Grid Background="#FF1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" Background="#FF2D2D30" Padding="15,10">
            <TextBlock Text="Move tagged images into sub-folders"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#FFF1F1F1"/>
        </Border>

        <TextBlock Grid.Row="1"
                   Text="Choose a sub-folder name for each tag."
                   FontSize="12"
                   Foreground="#FFB4B4B4"
                   Margin="20,15,20,5"/>

        <!-- One row per tag in use -->
        <ScrollViewer Grid.Row="2" Margin="20,5,20,10" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="TagRows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Style="{StaticResource TagBadgeStyle}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0">
                                <TextBlock Text="{Binding Tag}"
                                           Style="{StaticResource TagBadgeTextStyle}"/>
                            </Border>

                            <TextBox Grid.Column="1"
                                     Text="{Binding FolderName, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center"
                                     Padding="6,4"/>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding CountLabel}"
                                       Foreground="#FFB4B4B4"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="20,0,20,20">
            <Button Content="Cancel"
                    Click="CancelButton_Click"
                    IsCancel="True"
                    Padding="20,8"
                    MinWidth="90"
                    Margin="0,0,10,0"/>
            <Button Content="Move"
                    Click="MoveButton_Click"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Padding="20,8"
                    MinWidth="90"/>
        </StackPanel>
    </Grid>
</Window>
