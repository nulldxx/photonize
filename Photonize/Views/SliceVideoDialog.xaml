<Window x:Class="Photonize.Views.SliceVideoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Slice Video" Height="300" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        BorderBrush="#FF2A2A2A"
        BorderThickness="1"
        WindowStyle="None"
        AllowsTransparency="False">

    <Grid Background="#FF1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" Background="#FF2D2D30" Padding="15,10">
            <TextBlock Text="Slice video into parts"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#FFF1F1F1"/>
        </Border>

        <TextBlock Grid.Row="1"
                   x:Name="SubjectText"
                   FontSize="12"
                   Foreground="#FFB4B4B4"
                   TextWrapping="Wrap"
                   Margin="20,15,20,5"/>

        <StackPanel Grid.Row="2" Margin="20,10,20,10">
            <TextBlock Text="Length of each part, in seconds"
                       Foreground="#FFF1F1F1"
                       Margin="0,0,0,6"/>

            <TextBox x:Name="SecondsBox"
                     MaxLength="6"
                     Padding="6,4"
                     VerticalContentAlignment="Center"
                     PreviewTextInput="SecondsBox_PreviewTextInput"
                     TextChanged="SecondsBox_TextChanged"/>

            <TextBlock x:Name="PreviewText"
                       FontSize="12"
                       Foreground="#FFB4B4B4"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"/>

            <!-- Stream copy cuts on keyframes, so parts are approximate. Saying so
                 here is cheaper than fielding the "why is part 1 twelve seconds?"
                 question later. -->
            <TextBlock Text="Cuts are made at the nearest keyframe, so parts may vary by a second or two. Nothing is re-encoded."
                       FontSize="11"
                       Foreground="#FF808080"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="20,0,20,20">
            <Button Content="Cancel"
                    Click="CancelButton_Click"
                    IsCancel="True"
                    Padding="20,8"
                    MinWidth="90"
                    Margin="0,0,10,0"/>
            <Button x:Name="SliceButton"
                    Content="Slice"
                    Click="SliceButton_Click"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Padding="20,8"
                    MinWidth="90"/>
        </StackPanel>
    </Grid>
</Window>
